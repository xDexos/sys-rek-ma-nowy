# Serwer LLM zgodny z OpenAI: Ollama (http://localhost:11434/v1) lub LM Studio (http://localhost:1234/v1)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local
# Modele badania (nazwy jak na serwerze), rozdzielone przecinkami
LLM_MODELS=gemma4:e2b
# Opis sprzętu zapisywany w manifeście (np. "RX 6600 8 GB, 15 GB RAM")
LLM_HARDWARE=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Inny katalog danych dla wszystkich etapów i dashboardu (domyślnie data), np. data/demo
# SYSREKMAG_DATA_DIR=data
